# Only needed for the GitHub enrichment and the one-time star history bootstrap.
# The HACS and Home Assistant analytics sources need no token at all.
#
# Use a classic personal access token with NO scopes ticked. Everything read here is
# public; the token only lifts the rate limit from 60 requests an hour to 5,000.
GITHUB_TOKEN=

# Path to the SQLite file (optional, defaults to data/hacs_trends.db)
# HACS_TRENDS_DB=data/hacs_trends.db

# Work from downloaded fixtures instead of the network (offline development)
# HACS_TRENDS_FIXTURES=data/fixtures

# Places a repository has to move since yesterday before the page draws a rank arrow
# (optional, defaults to 3). On GitHub: a repository variable of the same name.
# HACS_TRENDS_RANK_ARROW_MIN=3
