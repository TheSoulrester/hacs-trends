# Python
.venv/
__pycache__/
*.py[cod]

# Local configuration: holds the GitHub token
.env

# SQLite database - a cache, rebuilt from the committed data files on every run
*.db
*.db-journal
*.db-wal
*.db-shm

# Generated by `hacs-trends export`; the workflow builds it fresh for every deployment
web/data.json

# Downloaded source data for offline development (see README), about 3 MB
data/fixtures/
# Clone of the HACS default lists, fetched again on every run
data/cache/
# Uncompressed star bootstrap output and its progress file; only the .gz is committed
data/stars/*.jsonl

# Local working notes, not part of the project
notes/

# macOS
.DS_Store
